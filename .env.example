# Generate real values with: node scripts/setup.mjs --url http://localhost:3000
# APP_URL must match the address in the browser exactly, including the port.
APP_URL=http://localhost:3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=GENERATE_WITH_SETUP
SESSION_SECRET=GENERATE_WITH_SETUP
# Enable only when ready to send your own real readings after review in the UI.
LIVE_SUBMISSIONS_ENABLED=false
# Optional for a host installation. Docker sets this to /data/bill-hub.sqlite.
# DATABASE_PATH=./data/bill-hub.sqlite
